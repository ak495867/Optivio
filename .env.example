# Optivio configuration template
# Copy to .env locally and populate secrets through a secret manager or shell environment.
# Never commit .env or real credentials.
#
# Only variables actually consumed by the codebase are listed. Any variable that is
# commented out below is a *reference* value the system may adopt later; it is not
# currently read by any code path. The order matches the central loader in
# options_agent/config.py.

# Execution and broker
OPTIVIO_MODE=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Canonical data-feed selector. The legacy name ALPACA_OPTIONS_FEED is also accepted.
ALPACA_DATA_FEED=indicative
ALPACA_PAPER=true

# Groq supervisory LLM; advisory only, never on the order hot path
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0

# Model selection and reproducibility
OPTIVIO_MODEL_VERSION=optivio-hive-kronos-v0.1.0

# Portfolio and risk limits
OPTIVIO_MAX_ORDER_NOTIONAL=2500
OPTIVIO_MAX_OPEN_NOTIONAL=10000
OPTIVIO_MAX_DAILY_LOSS_FRACTION=0.02
OPTIVIO_MAX_ABS_DELTA=1000
OPTIVIO_MAX_ABS_GAMMA=500
OPTIVIO_MAX_ABS_THETA=5000
OPTIVIO_MAX_ABS_VEGA=5000
OPTIVIO_MAX_ABS_RHO=5000
OPTIVIO_KILL_SWITCH=false

# Research controls
OPTIVIO_PURGE_BARS=1
OPTIVIO_EMBARGO_BARS=1

# Optional bounded connectivity smoke test (never submits orders)
OPTIVIO_TEST_SYMBOLS=
OPTIVIO_STREAM_SECONDS=5

# ---------------------------------------------------------------------------
# Reference values only — NOT currently read by the code. Kept here so an operator
# sees the intended safety posture; implementations that adopt them must consume the
# same names from config.py.
# ---------------------------------------------------------------------------
# OPTIVIO_CHECKPOINT_PATH=
# OPTIVIO_RANDOM_SEED=7
# OPTIVIO_LOOKBACK=32
# OPTIVIO_MAX_CONTEXT=512
# OPTIVIO_INITIAL_EQUITY=100000
# OPTIVIO_MAX_SINGLE_WEIGHT=0.20
# OPTIVIO_MAX_GROSS_WEIGHT=1.00
# OPTIVIO_MIN_CASH_WEIGHT=0.10
# OPTIVIO_TARGET_ANNUAL_VOL=0.15
# OPTIVIO_MAX_QUOTE_AGE_SECONDS=15
# OPTIVIO_MAX_QUEUE=10000
# OPTIVIO_MAX_ORDER_RATE_PER_MINUTE=20
# OPTIVIO_RECONNECT_MAX_RETRIES=10
# OPTIVIO_RECONCILIATION_INTERVAL_SECONDS=30
# OPTIVIO_STALE_DATA_ACTION=halt
# OPTIVIO_DATA_ROOT=./data
# OPTIVIO_AUDIT_LOG_PATH=./data/audit/events.jsonl
# OPTIVIO_MANIFEST_PATH=./data/manifests/current.json
# OPTIVIO_LOG_LEVEL=INFO
# OPTIVIO_METRICS_PORT=9108
# OPTIVIO_ZERO_SHOT=true
# OPTIVIO_EVOLUTIONARY_SEARCH=false
# OPTIVIO_ALLOW_NETWORK_IN_RESEARCH=false
# OPTIVIO_PAPER_ONLY=true   (legacy alias for ALPACA_PAPER)